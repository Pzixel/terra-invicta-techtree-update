
// Dark Skies DLC


//// RECOVERY EVENTS

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldBooks=Knihy Starého světa
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.summary=Při sanaci čtvrtí, které byly narychlo evakuovány a po válce ponechány napospas osudu, objevili stavební dělníci skrýš se starými knihami.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.query=Ve skrýši se nacházely ukázky klasické literatury napsané dlouho před válkou, vysokoškolská skripta z přírodních i společenských věd a dokonce i jeden či dva sešity z kdysi populární a dlouho vycházející řady komiksů. To vše významně přispěje k obnově vzdělávacího systému {targetNationNameWithPrep}.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.option0=Z minulosti se toho máme ještě co naučit.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.optionResult0=Stavební dělníci {targetNationNameWithArticleAndPlacePrep} objevili skrýš se starými knihami.

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldDoctrines=Doktríny Starého světa
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.summary=Při odklízení trosek z vybombardovaných měst a pevností, které byly po válce ponechány osudu, objevili stavební dělníci skrytý systém bunkrů.
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.query=Tolik let po válce již případní přeživší komplex dávno opustili a veškeré zbraně i zásoby podlehly rzi a zubu času. V jednom z nižších podlaží jsme však našli sbírku polních příruček a válečných plánů, které podrobně vysvětlují, jak uplatňovat doktrínu armád z válečné éry. Tyto materiály výrazně přispějí ke zlepšení chápání války ze strany země {targetNationNameWithArticle}.
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.option0=Je to opravdu tak dobrý nápad učit se od našich předchůdců?
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.optionResult0=Stavební dělníci {targetNationNameWithArticleAndPlacePrep} odhalili skrytý systém bunkrů.

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldMedia=Média Starého světa
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.summary=Při sanaci čtvrtí, které byly narychlo evakuovány a po válce ponechány napospas osudu, objevili stavební dělníci skrýš se starými filmy a hudebními nosiči.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.query=Ačkoli jsou technologické postupy související se záznamem a přehráváním těchto nosičů pro naše techniky v dnešní době relativně snadno reprodukovatelné, je třeba věnovat zvláštní pozornost tomu, aby se tyto pásky a desky během procesu restaurování dále nepoškodily. Jakmile je však vyčistíme a převedeme na odpovídající formát pro současná zařízení, předpokládáme, že diváky bude zajímat, jaké filmy a jakou hudbu měli lidé před válkou v oblibě.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.option0=Zpřístupníme je celému světu.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionResult0=Stavební dělníci {targetNationNameWithArticleAndPlacePrep} objevili skrýš se starými filmy a hudbou.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.option1=Ponecháme je {targetNationNameWithArticleAndPlacePrep} a budeme účtovat poplatek za exkluzivní přístup.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionDetail1=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionResult1=Stavební dělníci {targetNationNameWithArticleAndPlacePrep} objevili skrýš se starými filmy a hudbou.

TINarrativeEventTemplate.displayName.event_PostApoc_MemorialtotheFallen=Památník padlým
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.summary=Občané celé země {targetNationNameWithArticle} se shromáždili na slavnosti u příležitosti připomínky padlých.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.query=Členové vlády, kaplani i zástupci veřejnosti se střídali v projevech a předčítali jména těch, kteří zahynuli při jaderné katastrofě v roce 1962. Tyto obřady jsou nadmíru důstojné a probíhají podle zavedeného řádu, plní však důležitou úlohu v tom, že pomáhají občanům udržet si pevné zakotvení v této postapokalyptické éře. I když svět začíná psát novou kapitolu historie, nezapomíná na rozsáhlou zkázu způsobenou jadernými zbraněmi a slibuje, že už se to nebude opakovat.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.option0=Abychom nezapomněli.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.optionResult0={summary}



TINarrativeEventTemplate.displayName.event_PostApoc_UnauthorizedSalvage=Neoprávněné rabování
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.summary=V ruinách regionu {targetRegionName} operují nelegální sběrači cenností.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.query=Tyto oblasti bohužel nejsou plně pod kontrolou legitimních orgánů země {targetNationAdjective}, pročež není možné účinně zabránit některým podnikavým jedincům v tom, aby se z vlastní iniciativy nepokoušeli dopomoci si k majetku z válečného období. Tento stav nejenže přispívá k rozkvětu černého trhu, který podkopává hospodářskou obnovu země {targetNationNameWithArticle}, ale zároveň zvyšuje napětí mezi přeživšími komunitami, které si v těchto válkou zpustošených oblastech stále s námahou vydělávají na živobytí a i nadále si na ně činí nárok.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.option0=To již nemáme ve svých rukách.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.optionDetail0=<skip/>
