
// Dark Skies DLC


//// RECOVERY EVENTS

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldBooks=Książki ze starego świata
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.summary=Podczas przeczesywania okolic pospiesznie opuszczonych po wojnie nasi robotnicy rekonstrukcyjni znaleźli skrytkę ze starymi książkami.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.query=Skrytka zawierała klasyki literatury napisane na długo przed wojną, podręczniki akademickie nauk ścisłych i humanistycznych, a nawet kilka zeszytów niegdyś popularnej serii komiksów. To bardzo pomoże w odbudowie systemu edukacji państwa {targetNationNameWithPrep}.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.option0=Wciąż jeszcze musimy się wiele nauczyć z przeszłości.
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldBooks.optionResult0=Robotnicy rekonstrukcyjni {targetNationNameWithArticleAndPlacePrep} odkryli skrytkę ze starymi książkami.

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldDoctrines=Doktryny starego świata
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.summary=Podczas sprzątania gruzów z miast i fortec zbombardowanych i opuszczonych po wojnie robotnicy rekonstrukcyjni odkryli ukryty kompleks bunkrów.
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.query=Od wojny minęło tyle lat, że ocaleńcy już dawno opuścili ten kompleks, zaś broń i zapasy do niczego się nie nadają. Na niższych poziomach znaleźliśmy jednak zbiór podręczników polowych i planów wojennych, które objaśniają szczegółowo zastosowanie doktryny wojskowej z czasów wojennych. To bardzo pomoże państwu {targetNationNameWithArticle} w zrozumieniu wojny.
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.option0=Czy to na pewno wartościowa rzecz do nauki od naszych przodków?
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldDoctrines.optionResult0=Robotnicy rekonstrukcyjni {targetNationNameWithArticleAndPlacePrep} odkryli kompleks ukrytych bunkrów.

TINarrativeEventTemplate.displayName.event_PostApoc_OldWorldMedia=Media ze starego świata
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.summary=Podczas przeczesywania okolic pospiesznie opuszczonych po wojnie nasi robotnicy rekonstrukcyjni znaleźli skrytkę ze starymi filmami i muzyką.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.query=Choć nasi inżynierowie relatywnie łatwo mogą zrekonstruować technologię potrzebną do nagrywania i odtwarzania tych mediów, obchodzenie się z taśmami i płytami wymaga dużej ostrożności, gdyż mogą one ulec dalszemu uszkodzeniu. Jeśli jednak uda się nam je wyczyścić i przeformatować do użytku na nowoczesnych urządzeniach, współcześni widzowie na pewno będą ciekawi filmów i muzyki, których ludzie słuchali przed wojną.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.option0=Pokażmy je całemu światu.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionResult0=Robotnicy rekonstrukcyjni {targetNationNameWithArticleAndPlacePrep} odkryli skrytkę ze starymi filmami i muzyką.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.option1=Zatrzymajmy je {targetNationNameWithArticleAndPlacePrep} i każmy sobie płacić za ekskluzywny dostęp.
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionDetail1=<skip/>
TINarrativeEventTemplate.event_PostApoc_OldWorldMedia.optionResult1=Robotnicy rekonstrukcyjni {targetNationNameWithArticleAndPlacePrep} odkryli skrytkę ze starymi filmami i muzyką.

TINarrativeEventTemplate.displayName.event_PostApoc_MemorialtotheFallen=Memoriał dla poległych
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.summary=Mieszkańcy z całego państwa {targetNationNameWithArticle} zebrali się, by uczcić odbywający się co pięć lat memoriał dla poległych.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.query=Urzędnicy państwowi, kapelani i przedstawiciele publiki przemawiali naprzemiennie i odczytywali imiona ludzi, którzy zginęli podczas katastrofy nuklearnej w 1962. To uroczyste i powtarzalne ceremonie, których najważniejszym celem jest utrzymanie pamięci wśród obywateli postapokaliptycznej ery. Choć cały świat postanowił otworzyć nowy rozdział w historii, ludzie muszą pamiętać o masowych zniszczeniach spowodowanych użyciem broni nuklearnej, by już nigdy więcej się to nie powtórzyło.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.option0=Inaczej te wydarzenia pójdą w niepamięć.
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_MemorialtotheFallen.optionResult0={summary}



TINarrativeEventTemplate.displayName.event_PostApoc_UnauthorizedSalvage=Nieautoryzowane wydobycie
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.summary=W ruinach rozmieszczonych w regionie {targetRegionName} trwają nieautoryzowane prace wydobywcze.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.query=Niestety, jako że te obszary nie są pod pełną kontrolą legalnych {targetNationAdjective} władz, niewiele można zrobić w celu powstrzymania pewnych przedsiębiorczych jednostek przed próbami odzyskania obiektów z epoki wojennej. Działania te powodują rozrost czarnego rynku, który źle wpływa na ekonomię państwa {targetNationNameWithArticle}, a przy okazji prowadzi do tarć z nielicznymi społecznościami ocalałych, które próbują przetrwać na terenach powojennych i uważają się za ich właścicieli.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.option0=To się wymknęło spod kontroli.
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.optionDetail0=<skip/>
TINarrativeEventTemplate.event_PostApoc_UnauthorizedSalvage.option0.outcome0=Operacje wydobywcze trwają dalej.
